# /root/workspace/reservation_sys_go/deploy/nginx/nginx.conf

worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    keepalive_timeout 65;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    upstream gateway_backend {
        server gateway:8080;
    }

    upstream reservation_backend {
        server reservation:8081;
    }

    upstream admin_backend {
        server admin:8082;
    }

    upstream content_backend {
        server content-service:5000;
    }

    server{
        listen 80;
        server_name localhost szuedf.org.cn www.szuedf.org.cn 49.232.156.42;

        location /health {
            return 200 "OK";
            add_header Content-Type text/plain;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        server_name localhost szuedf.org.cn www.szuedf.org.cn 49.232.156.42;

        ssl_certificate /etc/nginx/ssl/szuedf.org.cn_bundle.crt;
        ssl_certificate_key /etc/nginx/ssl/szuedf.org.cn.key;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # 微信域名校验文件（无需上传实体txt，直接返回校验内容）
        location = /MP_verify_qGSUvs0URQbbwCDa.txt {
            default_type text/plain;
            return 200 "qGSUvs0URQbbwCDa";
        }

        # 微信服务器消息入口
        location /wx {
            proxy_pass http://gateway_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # 微信 OAuth 回调
        location /api/gateway/auth {
            proxy_pass http://gateway_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # 内容管理 API（新增）
        location /api/content/ {
            proxy_pass http://content_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            client_max_body_size 100m;
            # 禁止缓存，确保后台修改后前端实时同步
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
        }

        # 内容管理上传的图片（由content后端提供静态文件）
        location /uploads/ {
            proxy_pass http://content_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # 微信分享配置管理页
        location = /share-admin {
            proxy_pass http://content_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }


        # SSE 实时推送端点（预约）
        location /api/reservation/events {
            proxy_pass http://reservation_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_set_header Connection '';
            chunked_transfer_encoding off;
        }

        # 预约 API
        location /api/reservation/ {
            proxy_pass http://reservation_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # 管理后台 SPA
        location /admin {
            root /usr/share/nginx/html;
            try_files $uri $uri/ /admin/index.html;
        }

        # SSE 实时推送端点（Admin）
        location /api/admin/events {
            proxy_pass http://admin_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_set_header Connection '';
            chunked_transfer_encoding off;
        }

        location /api/admin/ {
            proxy_pass http://admin_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # 预约 SPA（Vue 静态文件，history 模式）
        location / {
            root /usr/share/nginx/html/reservation;
            try_files $uri $uri/ /index.html;
        }
    }
}
