# 本地开发 Nginx 配置（仅 HTTP，无 HTTPS）
# 使用方法: docker compose -f docker-compose.local.yaml up

# 自动根据 CPU 核心数设置工作进程
worker_processes auto;

# 错误日志路径，"warn" 表示只记录警告及以上级别的日志
error_log /var/log/nginx/error.log warn;

# 存储 Nginx 主进程 PID 的文件路径，用于进程管理
pid /var/run/nginx.pid;

events {
    # 每个工作进程能同时处理的最大连接数量
    worker_connections 1024;
}


http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # 日志格式定义
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    keepalive_timeout 65;

    # Gzip 压缩
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # 上游服务器定义
    upstream server_backend {
        server server:8080;
    }

    server {
        listen 80;
        server_name localhost;

        # 健康检查
        location /health {
            return 200 "OK";
            add_header Content-Type text/plain;
        }

        # 微信服务器消息入口
        location /wx {
            proxy_pass http://server_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # 微信 OAuth 回调
        location /api/gateway/auth {
            proxy_pass http://server_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # 预约 SPA（Vue 静态文件，history 模式）
        location / {
            root /usr/share/nginx/html/reservation;
            try_files $uri $uri/ /index.html;
        }

        # SSE 实时推送端点（预约端）
        location /api/reservation/events {
            proxy_pass http://server_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_set_header Connection '';
            chunked_transfer_encoding off;
        }

        # 预约 API
        location /api/reservation/ {
            proxy_pass http://server_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # 管理后台 SPA（Vue 静态文件，history 模式）
        location /admin {
            root /usr/share/nginx/html;
            try_files $uri $uri/ /admin/index.html;
        }

        # SSE 实时推送端点（Admin）
        location /api/admin/events {
            proxy_pass http://server_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_set_header Connection '';
            chunked_transfer_encoding off;
        }

        # 管理后台 API
        location /api/admin/ {
            proxy_pass http://server_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
